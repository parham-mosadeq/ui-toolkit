{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@/src/*": ["./src/*"],
      "@/components/*": ["./src/components/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
