{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@/src/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "ui-toolkit": ["node_modules/ui-toolkit/dist"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": false,
    "lib": ["ESNext", "DOM"],
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src"]
}

